<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:paddingTop="60dp">

        <!-- Logo bubble -->
        <LinearLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="@drawable/bg_icon_circle"
            android:gravity="center"
            android:layout_marginBottom="16dp">
            <TextView
                android:text="🏥"
                android:textSize="38sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 4-color brand accent bar -->
        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="5dp"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/mottoBlue"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/mottoGreen"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/mottoOrange"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/mottoRed"/>
        </LinearLayout>

        <TextView
            android:text="Patient Registration"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="@font/sansserif"
            android:textColor="@color/mottoBlue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Create your patient account"
            android:textSize="13sp"
            android:textColor="@color/textMid"
            android:fontFamily="@font/sansserif"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="32dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- ── Form Card ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_card"
            android:elevation="3dp"
            android:layout_marginBottom="20dp">

            <!-- Card header tab -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="#1a4fa8">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="📝"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Account Details"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/sansserif"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Full Name -->
                <TextView
                    android:text="Full Name"
                    android:textSize="13sp"
                    android:fontFamily="@font/sansserif"
                    android:textStyle="bold"
                    android:textColor="@color/textMid"
                    android:layout_marginBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:fontFamily="@font/sansserif"
                    android:background="@drawable/rounded_edittext"
                    android:hint="e.g. Juan Dela Cruz"
                    android:inputType="textPersonName"
                    android:textSize="15sp"/>

                <!-- Email -->
                <TextView
                    android:text="Email Address"
                    android:textSize="13sp"
                    android:fontFamily="@font/sansserif"
                    android:textStyle="bold"
                    android:textColor="@color/textMid"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:fontFamily="@font/sansserif"
                    android:background="@drawable/rounded_edittext"
                    android:hint="your@email.com"
                    android:inputType="textEmailAddress"
                    android:textSize="15sp"/>

                <!-- Password -->
                <TextView
                    android:text="Password"
                    android:textSize="13sp"
                    android:fontFamily="@font/sansserif"
                    android:textStyle="bold"
                    android:textColor="@color/textMid"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/rounded_edittext"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="12dp">
                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/sansserif"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Min. 6 characters"
                        android:inputType="textPassword"
                        android:textSize="15sp"/>
                    <ImageButton
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@null"
                        android:src="@drawable/ic_eye_open"
                        android:contentDescription="Toggle password"
                        android:padding="6dp"/>
                </LinearLayout>

                <!-- Confirm Password -->
                <TextView
                    android:text="Confirm Password"
                    android:fontFamily="@font/sansserif"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/textMid"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/rounded_edittext"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="12dp">
                    <EditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Re-enter password"
                        android:inputType="textPassword"
                        android:textSize="15sp"/>
                    <ImageButton
                        android:id="@+id/btnToggleConfirm"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@null"
                        android:src="@drawable/ic_eye_open"
                        android:contentDescription="Toggle confirm password"
                        android:padding="6dp"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- Register Button -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:fontFamily="@font/sansserif"
            android:layout_height="56dp"
            android:backgroundTint="@color/mottoBlue"
            android:text="Create Patient Account"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"/>

        <!-- Login link -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="32dp">
            <TextView
                android:text="Already have an account? "
                android:fontFamily="@font/sansserif"
                android:textSize="14sp"
                android:textColor="@color/textMid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tvLogin"
                android:text="Log In"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/sansserif"
                android:textColor="@color/mottoBlue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>

</ScrollView>