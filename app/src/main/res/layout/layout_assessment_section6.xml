<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <!-- ══════════════════════════════════════ -->
    <!-- SECTION HEADER -->
    <!-- ══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="14dp"
        android:background="@drawable/rounded_card"
        android:elevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#e65100">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="🏥"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginEnd="10dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:text="Health Resources &amp; Leadership"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/sansserif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Community health, politics and concerns"
                    android:textSize="11sp"
                    android:textColor="#FFE0B2"
                    android:fontFamily="@font/sansserif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ══════════════════════════════════════ -->
    <!-- IV. HEALTH RESOURCES -->
    <!-- ══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="14dp"
        android:background="@drawable/rounded_card"
        android:elevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#1a4fa8">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="💊"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:text="Health Resources"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/sansserif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:text="BHC (Barangay Health Center) Awareness"
                android:textSize="13sp" android:textStyle="bold"
                android:fontFamily="@font/sansserif" android:textColor="@color/textMid"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <RadioGroup android:id="@+id/rgBhcAwareness"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">
                <RadioButton android:id="@+id/rbBhcAware" android:text="Aware"
                    android:fontFamily="@font/sansserif" android:textSize="14sp"
                    android:layout_marginEnd="16dp"/>
                <RadioButton android:id="@+id/rbBhcUnaware" android:text="Unaware"
                    android:fontFamily="@font/sansserif" android:textSize="14sp"/>
            </RadioGroup>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#E5E5E5" android:layout_marginBottom="14dp"/>

            <TextView android:text="BHC (Barangay Health Center) Schedule"
                android:textSize="13sp" android:textStyle="bold"
                android:fontFamily="@font/sansserif" android:textColor="@color/textMid"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/etBhcSchedule"
                android:hint="BHC (Barangay Health Center) Schedule"
                android:background="@drawable/rounded_edittext"
                android:fontFamily="@font/sansserif"
                android:padding="14dp" android:textSize="15sp"
                android:layout_marginBottom="14dp"
                android:layout_width="match_parent" android:layout_height="56dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#E5E5E5" android:layout_marginBottom="14dp"/>

            <TextView android:text="RHU (Rural Health Unit) Physician"
                android:textSize="13sp" android:textStyle="bold"
                android:fontFamily="@font/sansserif" android:textColor="@color/textMid"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/etRhuPhysician"
                android:hint="RHU (Rural Health Unit) Physician"
                android:background="@drawable/rounded_edittext"
                android:fontFamily="@font/sansserif"
                android:padding="14dp" android:textSize="15sp"
                android:layout_marginBottom="14dp"
                android:layout_width="match_parent" android:layout_height="56dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#E5E5E5" android:layout_marginBottom="14dp"/>

            <TextView android:text="RHU (Rural Health Unit) Nurse"
                android:textSize="13sp" android:textStyle="bold"
                android:fontFamily="@font/sansserif" android:textColor="@color/textMid"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/etRhuNurse"
                android:hint="RHU (Rural Health Unit) Nurse"
                android:background="@drawable/rounded_edittext"
                android:fontFamily="@font/sansserif"
                android:padding="14dp" android:textSize="15sp"
                android:layout_marginBottom="14dp"
                android:layout_width="match_parent" android:layout_height="56dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#E5E5E5" android:layout_marginBottom="14dp"/>

            <TextView android:text="BHC (Barangay Health Center) Midwife"
                android:textSize="13sp" android:textStyle="bold"
                android:fontFamily="@font/sansserif" android:textColor="@color/textMid"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/etBhcMidwife"
                android:hint="BHC (Barangay Health Center) Midwife"
                android:background="@drawable/rounded_edittext"
                android:fontFamily="@font/sansserif"
                android:padding="14dp" android:textSize="15sp"
                android:layout_marginBottom="14dp"
                android:layout_width="match_parent" android:layout_height="56dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#E5E5E5" android:layout_marginBottom="14dp"/>

            <TextView android:text="Supplies Availability"
                android:textSize="13sp" android:textStyle="bold"
                android:fontFamily="@font/sansserif" android:textColor="@color/textMid"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <RadioGroup android:id="@+id/rgSuppliesAvailability"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rbSuppliesAvailable" android:text="Available"
                    android:fontFamily="@font/sansserif" android:textSize="14sp"
                    android:layout_marginEnd="16dp"/>
                <RadioButton android:id="@+id/rbSuppliesUnavailable" android:text="Unavailable"
                    android:fontFamily="@font/sansserif" android:textSize="14sp"/>
            </RadioGroup>

        </LinearLayout>
    </LinearLayout>

    <!-- ══════════════════════════════════════ -->
    <!-- V. POLITICAL / LEADERSHIP -->
    <!-- ══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="14dp"
        android:background="@drawable/rounded_card"
        android:elevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#534ab7">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="🏛️"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:text="Political / Leadership"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/sansserif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:text="Community Leaders"
                android:textSize="13sp" android:textStyle="bold"
                android:fontFamily="@font/sansserif" android:textColor="@color/textMid"
                android:layout_marginBottom="2dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView
                android:text="Select all that apply"
                android:textSize="11sp"
                android:fontFamily="@font/sansserif" android:textColor="#888888"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbLeaderCaptain" android:text="Barangay Captain"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbLeaderKagawad" android:text="Kagawad"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbLeaderElderly" android:text="Elderly"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbLeaderBhw" android:text="BHW (Barangay Health Worker)"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbLeaderInfluential" android:text="Influential Person"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbLeaderReligious" android:text="Religious Leader"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbLeaderNeighbor" android:text="Neighbor"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#E5E5E5" android:layout_marginTop="14dp" android:layout_marginBottom="14dp"/>

            <TextView android:text="Community Conflicts"
                android:textSize="13sp" android:textStyle="bold"
                android:fontFamily="@font/sansserif" android:textColor="@color/textMid"
                android:layout_marginBottom="2dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView
                android:text="Select all that apply"
                android:textSize="11sp"
                android:fontFamily="@font/sansserif" android:textColor="#888888"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbConflictGossip" android:text="Gossip"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbConflictFamilyConflict" android:text="Family Conflict"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbConflictDrugs" android:text="Drugs"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbConflictRiot" android:text="Riot"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbConflictAlcohol" android:text="Alcohol"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbConflictOthers" android:text="Others"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/etConflictOthers"
                android:hint="Specify other conflict"
                android:background="@drawable/rounded_edittext"
                android:fontFamily="@font/sansserif"
                android:padding="14dp" android:textSize="15sp"
                android:layout_marginTop="8dp" android:layout_marginBottom="14dp"
                android:layout_width="match_parent" android:layout_height="56dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#E5E5E5" android:layout_marginBottom="14dp"/>

            <TextView android:text="Conflict Resolution"
                android:textSize="13sp" android:textStyle="bold"
                android:fontFamily="@font/sansserif" android:textColor="@color/textMid"
                android:layout_marginBottom="2dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView
                android:text="Select all that apply"
                android:textSize="11sp"
                android:fontFamily="@font/sansserif" android:textColor="#888888"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbResolutionSettlement" android:text="Amicable Settlement"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbResolutionBrgyHearing" android:text="Barangay Hearing"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbResolutionPolice" android:text="Police"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbResolutionOthers" android:text="Others"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/etResolutionOthers"
                android:hint="Specify other resolution"
                android:background="@drawable/rounded_edittext"
                android:fontFamily="@font/sansserif"
                android:padding="14dp" android:textSize="15sp"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent" android:layout_height="56dp"/>

        </LinearLayout>
    </LinearLayout>

    <!-- ══════════════════════════════════════ -->
    <!-- VI. CONCERNS / SUGGESTIONS -->
    <!-- ══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="14dp"
        android:background="@drawable/rounded_card"
        android:elevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#0f6e56">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="📝"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:text="Concerns / Suggestions"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/sansserif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:text="Write any concerns or suggestions below"
                android:textSize="13sp" android:textStyle="bold"
                android:fontFamily="@font/sansserif" android:textColor="@color/textMid"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/etConcernsSuggestions"
                android:hint="Concerns and Suggestions"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:gravity="top|start"
                android:background="@drawable/rounded_edittext"
                android:fontFamily="@font/sansserif"
                android:padding="14dp" android:textSize="15sp"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>