<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <!-- ICON BUBBLE -->
    <LinearLayout
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@drawable/pastel_blue_card"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <TextView
            android:text="🩺"
            android:textSize="38sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- TITLE -->
    <TextView
        android:text="Health Assessment"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="@font/sansserif"
        android:textColor="@color/textDark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="Record patient health details"
        android:textSize="14sp"
        android:textColor="@color/textMid"
        android:fontFamily="@font/sansserif"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="40dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- CREATE BUTTON -->
    <Button
        android:id="@+id/btnCreateAssessment"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/rounded_button_pink"
        android:text="Create New Assessment"
        android:textColor="@color/textDark"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/sansserif"/>

</LinearLayout>