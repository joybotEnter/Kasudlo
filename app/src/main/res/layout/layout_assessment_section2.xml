                android:textColor="@color/textDark"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbHealthStation" android:text="Health Station"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:textColor="@color/textDark"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbChurch" android:text="Church"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:textColor="@color/textDark"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbSchool" android:text="School"
