<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <!-- ══════════════════════════════════════ -->
    <!-- SECTION HEADER -->
    <!-- ══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="14dp"
        android:background="@drawable/rounded_card"
        android:elevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#1a7a4a">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="🏘️"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginEnd="10dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:text="II. Socio-Economic, Cultural &amp; Environmental"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/sansserif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Community services and economic data"
                    android:textSize="11sp"
                    android:textColor="#CCEEDD"
                    android:fontFamily="@font/sansserif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ══════════════════════════════════════ -->
    <!-- SERVICES IN THE COMMUNITY -->
    <!-- ══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="14dp"
        android:background="@drawable/rounded_card"
        android:elevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#0f6e56">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="🏥"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginEnd="10dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:text="Services in the Community"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/sansserif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Select all that apply"
                    android:textSize="11sp"
                    android:textColor="#CCEEDD"
                    android:fontFamily="@font/sansserif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <CheckBox android:id="@+id/cbReligiousServices" android:text="Religious Services"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:textColor="@color/textDark"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbLivelihoodServices" android:text="Livelihood Services"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:textColor="@color/textDark"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbHealthServices" android:text="Health Services"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:textColor="@color/textDark"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbGarbageCollection" android:text="Garbage Collection"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:textColor="@color/textDark"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbPeaceAndOrder" android:text="Peace and Order"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:textColor="@color/textDark"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cbCommOthers" android:text="Others"
                android:fontFamily="@font/sansserif" android:textSize="14sp"
                android:textColor="@color/textDark"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <TextView android:text="Specify other services"
                android:textSize="13sp" android:textStyle="bold"
                android:fontFamily="@font/sansserif" android:textColor="@color/textMid"
                android:layout_marginTop="8dp" android:layout_marginBottom="6dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/etCommOthers"
                android:hint="e.g. Livelihood assistance"
                android:background="@drawable/rounded_edittext"
                android:fontFamily="@font/sansserif"
                android:padding="14dp" android:textSize="15sp"
                android:layout_width="match_parent" android:layout_height="56dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ══════════════════════════════════════ -->
