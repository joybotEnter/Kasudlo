<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream">

    <!-- ══════════════════════════════════════ -->
    <!-- STICKY TOP HEADER -->
    <!-- ══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_card"
        android:elevation="6dp">

        <!-- Top Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <!-- Back Button -->


            <!-- Title Block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reports Dashboard"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/mottoBlue"
                    android:fontFamily="@font/sansserif"/>

                <TextView
                    android:id="@+id/tvReportStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Generate and share barangay health reports"
                    android:textSize="11sp"
                    android:textColor="@color/textMid"
                    android:fontFamily="@font/sansserif"/>

            </LinearLayout>

            <!-- Report Badge -->
            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄"
                    android:textSize="18sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Accent Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/mottoBlue"/>

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/mottoGreen"/>

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/mottoOrange"/>

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/mottoRed"/>

        </LinearLayout>

        <!-- Stats Count Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sections"
                android:textSize="11sp"
                android:textColor="@color/textMid"
                android:fontFamily="@font/sansserif"
                android:layout_marginEnd="10dp"/>

            <View
                android:layout_width="28dp"
                android:layout_height="6dp"
                android:background="@color/mottoBlue"
                android:layout_marginEnd="4dp"/>

            <View
                android:layout_width="28dp"
                android:layout_height="6dp"
                android:background="@color/mottoGreen"
                android:layout_marginEnd="4dp"/>

            <View
                android:layout_width="28dp"
                android:layout_height="6dp"
                android:background="@color/mottoOrange"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>



        </LinearLayout>

    </LinearLayout>

    <!-- ════════════════ -->
    <!-- SCROLLABLE BODY -->
    <!-- ════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ══════════════════════════════════════ -->
            <!-- STATS CARDS ROW -->
            <!-- ══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <!-- Monthly Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/rounded_card"
                    android:elevation="3dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_blue">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="📅"
                            android:textSize="18sp"/>

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monthly"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/mottoBlue"
                        android:fontFamily="@font/sansserif"
                        android:layout_marginTop="6dp"/>

                </LinearLayout>

                <!-- Barangays Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/rounded_card"
                    android:elevation="3dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_green">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🔢"
                            android:textSize="18sp"/>

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto Tally"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/mottoGreen"
                        android:fontFamily="@font/sansserif"
                        android:layout_marginTop="6dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ══════════════════════════════════════ -->
            <!-- SECTION: GENERATE REPORTS -->
            <!-- ══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp"
                android:background="@drawable/rounded_card"
                android:elevation="3dp">

                <!-- Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="#1a4fa8">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="📊"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Generate Reports"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/sansserif"/>

                </LinearLayout>

                <!-- Generate Monthly Report Row -->
                <LinearLayout
                    android:id="@+id/btnGenerate"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_icon_circle_blue">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="📅"
                            android:textSize="18sp"/>

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Generate Monthly Report"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/textDark"
                            android:fontFamily="@font/sansserif"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Compile this month's health data"
                            android:textSize="11sp"
                            android:textColor="@color/textMid"
                            android:fontFamily="@font/sansserif"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="@color/mottoBlue"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#E5E5E5"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>




                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#E5E5E5"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>

                <!-- Auto Tally Row -->
                <LinearLayout
                    android:id="@+id/btnAutoTally"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_icon_circle_green">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🔢"
                            android:textSize="18sp"/>

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto Tally"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/textDark"
                            android:fontFamily="@font/sansserif"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gender, age, education &amp; more"
                            android:textSize="11sp"
                            android:textColor="@color/textMid"
                            android:fontFamily="@font/sansserif"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="@color/mottoGreen"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#E5E5E5"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>

                <!-- Share Report Row -->
                <LinearLayout
                    android:id="@+id/btnShare"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_icon_circle_orange">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="📤"
                            android:textSize="18sp"/>

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Share Report"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/textDark"
                            android:fontFamily="@font/sansserif"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Send report to other recipients"
                            android:textSize="11sp"
                            android:textColor="@color/textMid"
                            android:fontFamily="@font/sansserif"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="@color/mottoOrange"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ══════════════════════════════════════ -->
            <!-- SECTION: PREVIEW -->
            <!-- ══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/reportPreviewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp"
                android:background="@drawable/rounded_card"
                android:elevation="3dp"
                android:visibility="gone">

                <!-- Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="#1a7a4a">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="📄"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Report Preview"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/sansserif"/>

                </LinearLayout>

                <!-- Preview Content -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_icon_circle_green">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="📋"
                            android:textSize="18sp"/>

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Generated Report"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/textDark"
                            android:fontFamily="@font/sansserif"
                            android:layout_marginBottom="6dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="#E5E5E5"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tvPreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Generated report will appear here"
                            android:textSize="13sp"
                            android:textColor="@color/textMid"
                            android:fontFamily="@font/sansserif"
                            android:lineSpacingExtra="4dp"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>