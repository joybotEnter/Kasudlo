<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream">

    <!-- ══════════════════════════════════════ -->
    <!-- STICKY TOP HEADER                      -->
    <!-- ══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_card"
        android:elevation="6dp">

        <!-- Top row: Logo + Title + Date pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <!-- Logo -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/profile_image_bg">
                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/kasudlo"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:contentDescription="App Logo"/>
            </FrameLayout>

            <!-- App name + subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KASUDLO"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/mottoBlue"
                    android:fontFamily="@font/sansserif"
                    android:letterSpacing="0.08"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Community Health App"
                    android:textSize="11sp"
                    android:textColor="@color/textMid"
                    android:fontFamily="@font/sansserif"/>
            </LinearLayout>

            <!-- Date pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mon, May 26"
                    android:textColor="@color/mottoBlue"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/sansserif"/>
            </LinearLayout>

        </LinearLayout>

        <!-- 4-color brand accent bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/mottoBlue"/>
            <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/mottoGreen"/>
            <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/mottoOrange"/>
            <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/mottoRed"/>
        </LinearLayout>

        <!-- Greeting row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello! 👋"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/textDark"
                    android:fontFamily="@font/sansserif"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Health Dashboard"
                    android:textSize="11sp"
                    android:textColor="@color/textMid"
                    android:fontFamily="@font/sansserif"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ════════════════ -->
    <!-- SCROLLABLE BODY -->
    <!-- ════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ── STAT CARDS ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <!-- My Profile card -->
                <LinearLayout
                    android:id="@+id/cardProfile"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/folder_card_pink"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_circle">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_home"
                            android:tint="@color/mottoRed"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Profile"
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:fontFamily="@font/sansserif"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to view ›"
                        android:textSize="11sp"
                        android:textColor="@color/mottoRed"
                        android:fontFamily="@font/sansserif"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <!-- My Assessments card -->
                <LinearLayout
                    android:id="@+id/cardAssessments"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/folder_card_green"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_circle">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_clipboard"
                            android:tint="@color/mottoGreen"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvAssessmentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="@color/textDark"
                        android:fontFamily="@font/sansserif"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Assessments"
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:fontFamily="@font/sansserif"
                        android:layout_marginTop="2dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to view ›"
                        android:textSize="11sp"
                        android:textColor="@color/mottoGreen"
                        android:fontFamily="@font/sansserif"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ── QUICK ACTIONS CARD ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_card"
                android:elevation="3dp"
                android:layout_marginBottom="20dp">

                <!-- Card header tab -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@color/mottoBlue">
                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="Q"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/mottoBlue"
                        android:gravity="center"
                        android:background="@drawable/circle_bg"
                        android:layout_marginEnd="10dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quick Actions"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/sansserif"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="16sp"/>
                </LinearLayout>

                <!-- Action: Add Assessment -->
                <LinearLayout
                    android:id="@+id/quickAssessments"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_file_doc"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add Assessment"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/textDark"
                            android:fontFamily="@font/sansserif"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Submit a new health assessment"
                            android:textSize="11sp"
                            android:textColor="@color/textMid"
                            android:fontFamily="@font/sansserif"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="@color/mottoBlue"/>

                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:background="#E0E0E0"
                    android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                <!-- Action: Add Individual Profile -->
                <LinearLayout
                    android:id="@+id/quickProfile"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_file_doc"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add Individual Profile"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/textDark"
                            android:fontFamily="@font/sansserif"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fill in your individual health profile"
                            android:textSize="11sp"
                            android:textColor="@color/textMid"
                            android:fontFamily="@font/sansserif"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="@color/mottoBlue"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>