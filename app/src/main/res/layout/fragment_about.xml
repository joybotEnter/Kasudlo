<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream">

    <!-- ══════════════════════════════════════ -->
    <!-- STICKY TOP HEADER                      -->
    <!-- ══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_card"
        android:elevation="6dp">

        <!-- Top row: Back + Title + Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/back_button_bg"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="‹"
                    android:textSize="26sp"
                    android:textColor="@color/mottoBlue"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About the App"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/mottoBlue"
                    android:fontFamily="@font/sansserif"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App info and features"
                    android:textSize="11sp"
                    android:textColor="@color/textMid"
                    android:fontFamily="@font/sansserif"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ️"
                    android:textSize="18sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- 4-color brand accent bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:orientation="horizontal">
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/mottoBlue"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/mottoGreen"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/mottoOrange"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/mottoRed"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ════════════════ -->
    <!-- SCROLLABLE BODY -->
    <!-- ════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ── App Logo Hero Card ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/rounded_card"
                android:elevation="3dp"
                android:padding="24dp"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:id="@+id/imgAbout"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center_horizontal"
                    android:src="@mipmap/ic_launcher"
                    android:scaleType="centerCrop"
                    android:layout_marginBottom="16dp"/>

                <ImageView
                    android:id="@+id/ivLogoText"
                    android:layout_width="180dp"
                    android:layout_height="48dp"
                    android:src="@drawable/kasudlotext"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="Kasudlo"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvMotto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="11sp"
                    android:textStyle="italic"
                    android:fontFamily="@font/sansserif"
                    android:textColor="@color/textMid"/>

            </LinearLayout>

            <!-- ── Acronym Card ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_card"
                android:elevation="3dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@color/mottoBlue">
                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="K"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/mottoBlue"
                        android:gravity="center"
                        android:background="@drawable/circle_bg"
                        android:layout_marginEnd="10dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="What does KASUDLO stand for?"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/sansserif"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔤"
                        android:textSize="16sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Knowledge Sharing through Active Participation and Unified Leadership for Open Communication"
                        android:textSize="14sp"
                        android:fontFamily="@font/sansserif"
                        android:textColor="@color/textDark"
                        android:lineSpacingMultiplier="1.5"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ── About Card ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_card"
                android:elevation="3dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="#2e7d32">
                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="A"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#2e7d32"
                        android:gravity="center"
                        android:background="@drawable/circle_bg"
                        android:layout_marginEnd="10dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="About"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/sansserif"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱"
                        android:textSize="16sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="KASUDLO is a mobile-driven community data gathering application designed to improve healthcare documentation, communication, and community assessment during nursing community duty.\n\nThe application promotes knowledge sharing, active participation, ethical data management, leadership, and open communication among healthcare workers and community members.\n\nThrough digital data collection, KASUDLO helps improve the accuracy, organization, and accessibility of community health information."
                        android:textSize="14sp"
                        android:fontFamily="@font/sansserif"
                        android:textColor="@color/textDark"
                        android:lineSpacingMultiplier="1.5"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ── Features Card ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_card"
                android:elevation="3dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="#e65100">
                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="F"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#e65100"
                        android:gravity="center"
                        android:background="@drawable/circle_bg"
                        android:layout_marginEnd="10dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Features"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/sansserif"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐"
                        android:textSize="16sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Feature: Community Profile -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/feature_row_bg"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                            android:text="🏘️" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Community Profile Form" android:textSize="14sp"
                            android:fontFamily="@font/sansserif" android:textColor="@color/textDark"
                            android:layout_marginStart="10dp"/>
                    </LinearLayout>



                    <!-- Feature: Health Assessment -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/feature_row_bg"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                            android:text="📋" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Health Assessment Checklist" android:textSize="14sp"
                            android:fontFamily="@font/sansserif" android:textColor="@color/textDark"
                            android:layout_marginStart="10dp"/>
                    </LinearLayout>

                    <!-- Feature: Report Generation -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/feature_row_bg"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                            android:text="📊" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Report Generation" android:textSize="14sp"
                            android:fontFamily="@font/sansserif" android:textColor="@color/textDark"
                            android:layout_marginStart="10dp"/>
                    </LinearLayout>

                    <!-- Feature: Dashboard -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/feature_row_bg"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                            android:text="📈" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Dashboard for Monitoring" android:textSize="14sp"
                            android:fontFamily="@font/sansserif" android:textColor="@color/textDark"
                            android:layout_marginStart="10dp"/>
                    </LinearLayout>

                    <!-- Feature: Privacy -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/feature_row_bg"
                        android:paddingStart="12dp" android:paddingEnd="12dp">
                        <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                            android:text="🔒" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Data Privacy and Security" android:textSize="14sp"
                            android:fontFamily="@font/sansserif" android:textColor="@color/textDark"
                            android:layout_marginStart="10dp"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>