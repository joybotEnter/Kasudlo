<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:theme="@style/Theme.Kasudlo"
        android:supportsRtl="true"
        android:label="Kasudlo"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">

        <!-- ✅ SPLASH — only launcher -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ✅ MAIN — no launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- ✅ LOGIN — no launcher, declared once -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <activity
            android:name=".AssessmentActivity"
            android:exported="false" />

        <activity
            android:name=".EditAssessmentActivity"
            android:exported="false" />

        <activity
            android:name=".CommunityProfileActivity"
            android:exported="false" />

        <activity
            android:name=".CommunityProfileListActivity"
            android:exported="false" />

        <activity
            android:name=".CommunityProfileDetailActivity"
            android:exported="false" />

        <activity
            android:name=".PatientDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".PatientAssessmentsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".PatientProfileActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".PatientProfilePreviewActivity"
            android:exported="false" />

        <activity
            android:name=".PatientAssessmentPreviewActivity"
            android:exported="false" />

    </application>

</manifest>